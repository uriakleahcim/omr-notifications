{
  "schemaVersion": 1,
  "revision": 1,
  "paused": false,
  "retention": {
    "enabled": true,
    "sensitive": false
  },
  "listeners": [
    {
      "id": "welcome-delay",
      "type": "time.after",
      "enabled": true,
      "config": {
        "seconds": 5
      }
    },
    {
      "id": "local-hooks",
      "type": "omarchy.hook",
      "enabled": true,
      "config": {
        "hooks": ["theme-set", "font-set"]
      }
    },
    {
      "id": "codex-cli",
      "type": "explicit.ingress",
      "enabled": true,
      "config": {
        "eventTypes": ["codex.agent-turn-complete"]
      }
    }
  ],
  "policies": [
    {
      "id": "welcome-notification",
      "enabled": true,
      "priority": 100,
      "trigger": {
        "types": ["time.after"],
        "listenerIds": ["welcome-delay"]
      },
      "conditions": [],
      "controls": {
        "cooldownSeconds": 60
      },
      "actions": [
        {
          "id": "welcome-popup",
          "type": "notification.show",
          "config": {
            "title": "OmR Notifications",
            "body": "The event-policy runtime is active.",
            "replaceKey": "welcome",
            "timeoutMs": 5000
          }
        },
        {
          "id": "record-welcome",
          "type": "event.record",
          "config": {}
        }
      ],
      "terminal": false,
      "errorStrategy": "continue"
    },
    {
      "id": "codex-response-complete",
      "enabled": true,
      "priority": 200,
      "trigger": {
        "types": ["codex.agent-turn-complete"],
        "listenerIds": ["codex-cli"]
      },
      "conditions": [],
      "controls": {
        "groupBy": ["data.threadId"],
        "cooldownSeconds": 1
      },
      "actions": [
        {
          "id": "codex-complete-popup",
          "type": "notification.show",
          "config": {
            "title": "Codex response complete",
            "body": "${event.data.project} is ready.",
            "appName": "Codex",
            "urgency": "normal",
            "timeoutMs": 8000,
            "icon": "smart_toy",
            "image": "devicon-aiassistant.svg",
            "replaceKey": "codex-${event.data.threadId}"
          }
        }
      ],
      "terminal": false,
      "errorStrategy": "continue"
    }
  ],
  "impactAcknowledgements": []
}
