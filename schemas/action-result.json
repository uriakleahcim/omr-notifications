{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.omr-notifications/schemas/action-result-v1.json",
  "title": "OmR Action Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "actionId", "actionType", "status", "startedAt", "finishedAt", "message", "output"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "actionId": { "type": "string" },
    "actionType": { "type": "string" },
    "status": { "enum": ["success", "failure", "skipped", "suppressed", "timed-out"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "message": { "type": "string" },
    "output": { "type": "string" }
  }
}
