{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.omr-notifications/schemas/action-v1.json",
  "title": "OmR Action v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "config"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "enum": ["notification.show", "notification.dismiss", "osd.show", "sound.play", "exec.argv", "listener.enable", "listener.disable", "event.record"]
    },
    "config": { "type": "object" }
  },
  "$defs": {
    "literalArgv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "notification.show" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "config": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "body": { "type": "string" },
              "glyph": { "type": "string", "minLength": 1 },
              "urgency": { "enum": ["low", "normal", "critical"] },
              "timeoutMs": { "type": "integer", "minimum": -1, "maximum": 2147483647 },
              "icon": { "type": "string", "minLength": 1 },
              "image": { "type": "string", "minLength": 1 },
              "appName": { "type": "string", "minLength": 1 },
              "replaceKey": { "type": "string", "minLength": 1 },
              "onClickArgv": { "$ref": "#/$defs/literalArgv" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "notification.dismiss" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "config": {
            "type": "object",
            "additionalProperties": false,
            "required": ["replaceKey"],
            "properties": {
              "replaceKey": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ]
}
